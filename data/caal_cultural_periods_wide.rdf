  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0041">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-2-0041</skos:notation>
    <skos:prefLabel xml:lang="en">EARLY ISLAMIC</skos:prefLabel>
    <skos:scopeNote xml:lang="en">From the Islamic conquest to c 11th century CE</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">От Исламского завоевания до ок. XI в. н.э.</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">从伊斯兰对外征服起到约11世纪</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Исламдын басып алуусунан тарта, XI кылымга чейин</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Аз истилои ислом то асри тақрибан асри XI милодӣ</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Yslam basyp alyşyndan b.e. XI asyryna çenli</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">Islom istilosidan milodiy XI asrgacha</skos:scopeNote>
