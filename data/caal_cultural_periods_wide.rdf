  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0039">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-2-0039</skos:notation>
    <skos:prefLabel xml:lang="en">XIONGNU</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A tribal confederation of nomadic peoples who inhabited the eastern Eurasian Steppe from the 3rd century BCE to the late 1st century CE.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Племенная конфедерация кочевников кот. заселяли возточный Евразийский степ от III в. д.н.э. до поздного I в. н.э.</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">欧亚大草原东部游牧民族部落联盟，公元前3世纪-公元1世纪。</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Көчмөндөрдүн уруулук конфедерациясы Чыгыш Евразия талааларын III к. б.з. ч жана I к. б.з. байырлаган</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Конфедератсияи қабилаҳои бодиянишин ки аз асри III пеш аз милод то охири асри I милодӣ дар даштҳои Шарқии Авруосиё сукунат дошт</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">B.e.öň III b.e I asyrynyň ahyryna çenli gündogar Yewraziýa sährasynda ýaşaýan çarwa halklaryň taýpa konfederasiýasy.</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">Miloddan avvalgi III asrdan milodiy I asr oxirigacha Sharqiy Yevrosiyo dashtida yashagan koʻchmanchi xalqlar qabilalarining konfederatsiyasi.</skos:scopeNote>
    <caal:dateRangeLabel>3rd century BCE to the late 1st century CE</caal:dateRangeLabel>
    <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-300</caal:startYear>
    <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</caal:endYear>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/CP-1-0005"/>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0044">
