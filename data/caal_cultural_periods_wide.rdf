    <caal:dateRangeLabel>c. 1,500,000-300,000 BP</caal:dateRangeLabel>
    <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1498050</caal:startYear>
    <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-298050</caal:endYear>
