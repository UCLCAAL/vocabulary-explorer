  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0038">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-2-0038</skos:notation>
    <skos:prefLabel xml:lang="en">UYGHUR KHAGANATE</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Uyghur Khaganate (or Uyghur Empire or Uighur Khaganate)</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Уйгурский каганат (или Уйгурская империя)</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">突厥汗国分裂后，西突厥汗国于公元7世纪形成（公元593-603年）。公元657年，被唐朝征服。</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Уйгур кагандыгы (же Уйгур империясы)</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Ҳоқонати Уйғурҳо (ё империяи Уйғурҳо)</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Uýgur Kaganaty (ýa-da Uýgur Imperiýasy)</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">Uygʻur xoqonligi (Uygʻur imperiyasi yoki Uygʻur xoqonligi)</skos:scopeNote>
