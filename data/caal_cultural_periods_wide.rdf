  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0001">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-2-0001</skos:notation>
    <skos:prefLabel xml:lang="en">Eastern Zhou</skos:prefLabel>
    <caal:dateRangeLabel>770-221 BCE</caal:dateRangeLabel>
    <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-770</caal:startYear>
    <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-221</caal:endYear>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/CP-1-0002"/>
    <skos:narrower>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-3-0010">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
        <skos:notation>CP-3-0010</skos:notation>
        <skos:prefLabel xml:lang="en">Spring and Autumn Period</skos:prefLabel>
        <caal:dateRangeLabel>771-476 BCE</caal:dateRangeLabel>
        <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-771</caal:startYear>
