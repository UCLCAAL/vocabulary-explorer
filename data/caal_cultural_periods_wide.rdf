  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-3-0003">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-3-0003</skos:notation>
    <skos:prefLabel xml:lang="en">Sintashta-Petrovka culture</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Some see as precursor to Andronova culture</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Некоторые считают предшественником андроновской культуры</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">也被视为安德罗诺沃文化的前身</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Айрымдар Андронов маданиятынын башаты деп эсептешет</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Баъзеҳо онро пешгузаштаи фарҳанги Андроново медонанд</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Käbirleri Andronowo medeniýetinden öňki döwür hökmünde görýärler</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">Shuningdek, bu Andronovo madaniyatining davomi sifatida ham qaraladi</skos:scopeNote>
    <caal:dateRangeLabel>c. 2,000-1600 BCE</caal:dateRangeLabel>
    <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-2000</caal:startYear>
    <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1600</caal:endYear>
    <skos:broader>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0053">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
        <skos:notation>CP-2-0053</skos:notation>
        <skos:prefLabel xml:lang="en">ANDRONOVO</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Debate over date range continue</skos:scopeNote>
        <skos:scopeNote xml:lang="ru">Дебаты по датам продолжаются</skos:scopeNote>
        <skos:scopeNote xml:lang="zh">持续就年代范围进行讨论</skos:scopeNote>
        <skos:scopeNote xml:lang="ky">Дата диапазону боюнча талкуулар улантылууда</skos:scopeNote>
        <skos:scopeNote xml:lang="tg">Баҳс дар бораи доираи сана идома дорад</skos:scopeNote>
        <skos:scopeNote xml:lang="tk">Sene aralygy baradaky jedel dowam edýär</skos:scopeNote>
        <skos:scopeNote xml:lang="uz">Davrlashtirish hali ham bahsli</skos:scopeNote>
        <caal:dateRangeLabel>c. 2,000-900 BCE</caal:dateRangeLabel>
        <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-2000</caal:startYear>
        <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-900</caal:endYear>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/CP-1-0012"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-3-0003"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-3-0001"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-3-0002"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-3-0004"/>
      </skos:Concept>
    </skos:broader>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-1-0003">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-1-0003</skos:notation>
    <skos:prefLabel xml:lang="en">Early Antiquity</skos:prefLabel>
    <caal:dateRangeLabel>329 BCE - 265 CE</caal:dateRangeLabel>
    <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-329</caal:startYear>
    <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">265</caal:endYear>
    <skos:topConceptOf rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0043">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-2-0043</skos:notation>
    <skos:prefLabel xml:lang="en">KARAKHANID</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Turkic dynasty that ruled in Transoxania in Central Asia. Also spelled Qarakhanids</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Тюркская династия кот. властвовал в Трансоксиане в Центральной Азии.</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">于公元999-1211年统治中亚河间地带的突厥王朝。名称又可拼作Qarakhanids。</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Борбордук Азиядагы Трансоксиананы башкарган Турк династиясы</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Сулолаи туркҳо, ки дар Мовароуннаҳр дар Осиёи Миёна хукмрон буданд. Ҳамчунин Қарахониён низ ёд шудаанд</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Merkezi Aziýanyň Transoksaniýada höküm süren türki dinastiýasy. Garahanidler diýip hem ýazylýar</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">999-1211-yillarda Movarounnahr hududida hukmronlik qilgan turkiy sulola. Qoraxoniylar deb ham ataladi</skos:scopeNote>
    <caal:dateRangeLabel>999–1211 CE</caal:dateRangeLabel>
    <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">999</caal:startYear>
    <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1211</caal:endYear>
    <skos:broader>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-1-0006">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
        <skos:notation>CP-1-0006</skos:notation>
        <skos:prefLabel xml:lang="en">ISLAMIC</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0040"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0041"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0042"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0043"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0044"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0045"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0046"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0047"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0048"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0049"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0050"/>
      </skos:Concept>
    </skos:broader>
  </skos:Concept>
