  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0013">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-2-0013</skos:notation>
    <skos:prefLabel xml:lang="en">Western Zhou</skos:prefLabel>
    <caal:dateRangeLabel>1046-771 BCE</caal:dateRangeLabel>
    <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1046</caal:startYear>
    <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-771</caal:endYear>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/CP-1-0002"/>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0046">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-2-0046</skos:notation>
    <skos:prefLabel xml:lang="en">QARAKHANID</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Turkic dynasty (999–1211 CE) that ruled in Transoxania in Central Asia. Also spelled Karakhanid</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Тюркская династия (999-1211 н.э.) кот. властвовал в Трансоксиане в Центральной Азии.</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">于公元999-1211年统治中亚河间地带的突厥王朝。名称又可拼作Karakhanids。</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Борбордук Азиядагы Трансоксиананы башкарган Турк династиясы ( 999-1211 б.з.)</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Сулолаи туркхо (999—1211), ки дар Осиёи Миёна дар Мовароуннаҳр хукмронӣ кардаанд. Қарахониён низ ёд шудаанд.</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Merkezi Aziýanyň Transoksaniýada höküm süren türki dinastiýasy (b.e. 999–1211). Garahanid diýip hem ýazylýar</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">999-1211-yillarda Movarounnahr hududida hukmronlik qilgan turkiy sulola. Qoraxoniylar deb ham ataladi</skos:scopeNote>
    <caal:dateRangeLabel>999–1211 CE</caal:dateRangeLabel>
    <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">999</caal:startYear>
    <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1211</caal:endYear>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/CP-1-0006"/>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0033">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-2-0033</skos:notation>
    <skos:prefLabel xml:lang="en">Shaybanids</skos:prefLabel>
    <caal:dateRangeLabel>1428-1599</caal:dateRangeLabel>
    <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1428</caal:startYear>
    <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1599</caal:endYear>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/CP-1-0005"/>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-3-0021">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-3-0021</skos:notation>
    <skos:prefLabel xml:lang="en">MIDDLE PALAEOLITHIC</skos:prefLabel>
    <caal:dateRangeLabel>c. 300,000-45,000 BP</caal:dateRangeLabel>
    <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-298050</caal:startYear>
    <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-43050</caal:endYear>
    <skos:broader>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0062">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
        <skos:notation>CP-2-0062</skos:notation>
        <skos:prefLabel xml:lang="en">PALAEOLITHIC</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Human activity in Central Asia from 1.5 to 1 million years ago, to the 10th millennia BCE</skos:scopeNote>
        <skos:scopeNote xml:lang="ru">Человеческая деятельность в Центральной Азии начиная с 1-1,5 млн. лет назад до 10-го тысячелетие д.н.э.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh">人类在中亚的活动从150万年前到100万年前，到公元前10万年</skos:scopeNote>
        <skos:scopeNote xml:lang="ky">Борбордук Азиядагы адам баласынын ишмердүүлүгү 1,5 миллиондон 1 миллион жыл мурун, биздин заманга чейинки 10 миң жылдыкка чейин</skos:scopeNote>
        <skos:scopeNote xml:lang="tg">Фаъолияти инсон дар Осиёи Миёна аз 1-1,5 миллион сол пеш то ҳазораи 10 пеш аз милод.</skos:scopeNote>
        <skos:scopeNote xml:lang="tk">B.e.öň 1,5 million ýyldan başlap 1 millon ýyla çenli, 10-njy müňýyllyga çenli Merkezi Aziýada adamzat hereketi</skos:scopeNote>
        <skos:scopeNote xml:lang="uz">Oʻrta Osiyoda 1-1,5 million yil avvaldan miloddan avvalgi 10-ming yilliklargacha boʻlgan inson faoliyati.</skos:scopeNote>
        <caal:dateRangeLabel>c. 1,500,000-16,000 BP</caal:dateRangeLabel>
        <caal:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1498050</caal:startYear>
        <caal:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-14050</caal:endYear>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/CP-1-0012"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-3-0020"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-3-0021"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-3-0022"/>
      </skos:Concept>
    </skos:broader>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-2-0051">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
    <skos:notation>CP-2-0051</skos:notation>
    <skos:prefLabel xml:lang="en">EARLY MEDIEVAL</skos:prefLabel>
    <skos:scopeNote xml:lang="en">?From the arrival of Islam, c. 650CE to the start of the Seljuk era, 1037CE</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">?От прибытие Ислама около 650 н.э.до начало Селджукской эры, 1037 н.э.</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">从伊斯兰教传入，约公元650年到塞尔柱王朝开端，公元1037年。</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Исламдын келишинен тартып, болжол менен 650-жылдан Сельджук доорунун башталышына чейин, 1037-жылга чейин</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">?Аз омадани Ислом, соли 650 то оғози даврони Салҷуқӣ, 1037-и милод</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Yslamyň gelmeginden, ýagny b.e. 650 ýyldan Seljuk erasynyň başyna çenli, b.e. 1037 ýyla çenli</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">650-yilda islomning kirib kelishidan to 1037-yil - Saljuqiylar hukmronligining boshlanguniga qadar</skos:scopeNote>
    <skos:broader>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/CP-1-0009">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
        <skos:notation>CP-1-0009</skos:notation>
        <skos:prefLabel xml:lang="en">Medieval</skos:prefLabel>
        <skos:scopeNote xml:lang="en">?From the arrival of Islam, c. 650CE to the end of the Timurid dynasty 1507 CE</skos:scopeNote>
        <skos:scopeNote xml:lang="ru">?От прибытие Ислама около 650 н.э. до конца династии Тимуридов в 1507 н.э.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh">从伊斯兰教传入，约公元650年到贴木儿王朝末期，公元1507年。</skos:scopeNote>
        <skos:scopeNote xml:lang="ky">Исламдын келишинен тартып, болжол менен 650-жылдан тарта 1507-жылы Тимурид династиясынын аягына чейин</skos:scopeNote>
        <skos:scopeNote xml:lang="tg">?Аз омадани Ислом, соли 650 то охири сулолаи Темуриён 1507 мелодӣ</skos:scopeNote>
        <skos:scopeNote xml:lang="tk">Yslamyň gelmeginden, b.e. 650 ýyl töwereklerinden Timur dinastiýasynyň ahyryna 1507-nji ýyla çenli</skos:scopeNote>
        <skos:scopeNote xml:lang="uz">650-yilda islomning kirib kelishidan to 1507-yil - Temuriylar sulolasining tugatilishiga qadar</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://vocab.uclcaal.org/scheme/cultural-periods"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0051"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/CP-2-0052"/>
      </skos:Concept>
    </skos:broader>
  </skos:Concept>
