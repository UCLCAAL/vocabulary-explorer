    <skos:notation>CP-2-0040</skos:notation>
    <skos:prefLabel xml:lang="en">ABBASID</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">от 750 -1258 н.э.</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">约公元750-1258年</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">750 -1258 б. з.</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">аз 750 -1258 пеш аз милод.</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">B.e. 750-1258 ýyla</skos:scopeNote>
    <caal:dateRangeLabel>c. 750–1258 CE</caal:dateRangeLabel>
