        <skos:prefLabel xml:lang="zh">石刻/题刻</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Жартастағы суреттер / жартастағы жазбалар</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Аскадагы сүрөттөр / аскалардагы жазуулар</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Сангнигора / навиштаҷот дар шахҳо</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Daşa oyulan suratlar / gaýa ýazgylary</skos:prefLabel>
