  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0033">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
    <skos:notation>MT-2-0033</skos:notation>
    <skos:prefLabel xml:lang="en">Ditched enclosure</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Углубленное ограждение</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">沟渠围场</skos:prefLabel>
    <skos:prefLabel xml:lang="kk">Тереңдетілген қоршау</skos:prefLabel>
    <skos:prefLabel xml:lang="ky">Тереңдетилген тосмо</skos:prefLabel>
    <skos:prefLabel xml:lang="tg">Девораки хандақ</skos:prefLabel>
    <skos:prefLabel xml:lang="tk">Çukur aýmança</skos:prefLabel>
    <skos:prefLabel xml:lang="uz">Xandaq</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An area of land enclosed by one or several boundary ditches.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Участок земли, окруженный одним или несколькими пограничными канавами.</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">以一个或多个沟渠为边界，被包围在内的区域。</skos:scopeNote>
    <skos:scopeNote xml:lang="kk">Бір немесе бірнеше шекаралық арықтармен қоршалған жер учаскесі.</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Бир же бир нече чек ара арыктары менен курчалган жер тилкеси.</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Қитъаи замин, ки бо як ё якчанд ҷӯйҳои сарҳадӣ иҳота шудааст.</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Bir ýa-da birnäçe araçäk çukurlary bilen gurşalan ýer bölegi.</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">Bir yoki bir nechta chegara ariqlari bilan o‘ralgan yer maydoni.</skos:scopeNote>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0002"/>
  </skos:Concept>
