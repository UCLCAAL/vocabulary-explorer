    <skos:notation>MT-3-0045</skos:notation>
    <skos:prefLabel xml:lang="en">Palaeochannel</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Палеоканал</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">古河道</skos:prefLabel>
    <skos:prefLabel xml:lang="kk">Палеоканал/Ескі арна</skos:prefLabel>
    <skos:prefLabel xml:lang="ky">Палеоканал</skos:prefLabel>
    <skos:prefLabel xml:lang="tg">Палеоканал</skos:prefLabel>
    <skos:prefLabel xml:lang="tk">Paleokanal</skos:prefLabel>
    <skos:prefLabel xml:lang="uz">qadimgi o‘zan</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The course or channel of a river or stream preserved as a soil feature</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Течение или русло реки или ручья, сохраненные в качестве элемента почвы</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">干涸保存并呈现出土地特征的河道、水路。</skos:scopeNote>
    <skos:scopeNote xml:lang="kk">Жер элементі ретінде сақталған өзеннің немесе бұлақтың арнасы немесе бағыты.</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Топурак элементи катары сакталган дарыя же арыктын агымы же нугу</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Маҷрои дарё ё ҷӯйбор, ки ҳамчун унсури хок нигоҳ дошта мешавад</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Toprak aýratynlygy hökmünde saklanyp galan derýanyň ýa-da çeşmäniň akymy ýa-da düýbi</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">Tuproq xususiyati sifatida saqlanib qolgan daryo yoki soyning yoʻnalishi yoki oʻzani</skos:scopeNote>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-2-0130"/>
  </skos:Concept>
