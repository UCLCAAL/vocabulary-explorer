  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0058">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
    <skos:notation>MT-2-0058</skos:notation>
    <skos:prefLabel xml:lang="en">Hospice</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Хоспис</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">救济院</skos:prefLabel>
    <skos:prefLabel xml:lang="kk">Хоспис</skos:prefLabel>
    <skos:prefLabel xml:lang="ky">Хоспис</skos:prefLabel>
    <skos:prefLabel xml:lang="tg">Осоишгоҳ</skos:prefLabel>
    <skos:prefLabel xml:lang="tk">Hospis</skos:prefLabel>
    <skos:prefLabel xml:lang="uz">kasalxona / boshpana</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A lodging for travellers, especially one run by a religious order.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Жилье для путешественников, особенно тот который управляется религиозным орденом.</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">旅客住宿的地方，尤指由修道会管理的那些。</skos:scopeNote>
    <skos:scopeNote xml:lang="kk">Саяхатшыларға арналған тұрғын үй, әсіресе діни бұйрықпен басқаратын орын.</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Саякатчылар үчүн жатакана, айрыкча диний буйрук менен башкарылат.</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Ҷойгоҳ барои сайёҳон, бахусус яке аз онҳо, ки бо фармони динӣ идора карда мешавад.</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Syýahatçylar üçin ýaşaýyş jaýy, esasanam dini tertip bilen dolandyrylýan jaý.</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">Sayohatchilar uchun turar joy, diniy idora etiladi.</skos:scopeNote>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0022"/>
  </skos:Concept>
