    <skos:prefLabel xml:lang="ru">Яма для захоронения</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">葬坑</skos:prefLabel>
    <skos:prefLabel xml:lang="kk">Жерлеу шұңқыры</skos:prefLabel>
    <skos:prefLabel xml:lang="ky">Көмүү чуңкуру</skos:prefLabel>
    <skos:prefLabel xml:lang="tg">Чоҳ барои дафн</skos:prefLabel>
    <skos:prefLabel xml:lang="tk">Jaýlama çukury</skos:prefLabel>
    <skos:prefLabel xml:lang="uz">O‘ra</skos:prefLabel>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-2-0011"/>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-3-0066">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
    <skos:notation>MT-3-0066</skos:notation>
    <skos:prefLabel xml:lang="en">Well</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Колодец</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">井</skos:prefLabel>
    <skos:prefLabel xml:lang="kk">Құдық</skos:prefLabel>
    <skos:prefLabel xml:lang="ky">Кудук</skos:prefLabel>
    <skos:prefLabel xml:lang="tg">Чоҳи об</skos:prefLabel>
    <skos:prefLabel xml:lang="tk">Guýy</skos:prefLabel>
    <skos:prefLabel xml:lang="uz">Quduq</skos:prefLabel>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-2-0129"/>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0004">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
    <skos:notation>MT-2-0004</skos:notation>
    <skos:prefLabel xml:lang="en">Barn</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Амбар</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">谷仓</skos:prefLabel>
    <skos:prefLabel xml:lang="kk">Астық қоймасы</skos:prefLabel>
    <skos:prefLabel xml:lang="ky">Кампа</skos:prefLabel>
    <skos:prefLabel xml:lang="tg">Анбор</skos:prefLabel>
    <skos:prefLabel xml:lang="tk">Ammar</skos:prefLabel>
    <skos:prefLabel xml:lang="uz">Ombor</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A building for the storage and processing of crops and for housing straw, farm equipment, and occasionally livestock and their fodder.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Здание для хранения и переработки сельскохозяйственных культур, а также для размещения соломы, сельскохозяйственного оборудования, а иногда и домашнего скота и его кормов.</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">用作存储和加工庄稼、存放稻草、农具的建筑，有时也会用于安置牲畜和饲料。</skos:scopeNote>
    <skos:scopeNote xml:lang="kk">Ауыл шаруашылығы дақылдарын сақтауға, өңдеуге, сонымен қатар сабан, ауыл шаруашылығы құрал-жабдықтары, ал кейде мал мен оның азығын орналастыруға арналған ғимарат.</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Өсүмдүктөрдү сактоо жана кайра иштетүү, ошондой эле саман, айыл чарба шаймандары, кээде мал жана анын тоюттарын жайгаштыруу үчүн имарат.</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Бино барои нигоҳдорӣ ва коркарди зироатҳо, инчунин коҳ, техникаи кишоварзӣ ва баъзан чорво ва хӯроки онҳо.</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Ekinleri saklamak we gaýtadan işlemek, saman, ferma enjamlary, käwagt mallar we ot-iýmler üçin bina.</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">Hosilni saqlash va qayta ishlash, shuningdek, somon, dehqonchilik asboblari va ba'zida mollarni va ularning ozuqasini joylashtirish uchun mo‘ljallangan bino.</skos:scopeNote>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0002"/>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0117">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
    <skos:notation>MT-2-0117</skos:notation>
    <skos:prefLabel xml:lang="en">Town</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Городок</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">城镇/市镇</skos:prefLabel>
    <skos:prefLabel xml:lang="kk">Қала жұрты</skos:prefLabel>
