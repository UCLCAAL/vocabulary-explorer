    <skos:scopeNote xml:lang="en">Ditch or channel used for irrigation.</skos:scopeNote>
    <skos:scopeNote xml:lang="kk">Суару үшін пайдаланылатын ор немесе канал.</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Сугат үчүн колдонулган арык же канал.</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Хандақ ва ё канале, ки барои обёрӣ истифода мешавад.</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Suwaryş üçin ulanylýan ýap ýa-da kanal.</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">Sug‘orish uchun ishlatiladigan ariq yoki kanal.</skos:scopeNote>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0002"/>
  </skos:Concept>
