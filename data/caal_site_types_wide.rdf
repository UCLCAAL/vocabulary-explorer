        <skos:prefLabel xml:lang="zh">农业与生业</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Ауыл шаруашылығы және тұруы</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Айыл чарбасы жана жашоо</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Хоҷагии қишлоқ ва маишат</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Oba hojalyk we eklenç</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">Qishloq xo‘jaligi va turmush</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is the top term for the class.</skos:scopeNote>
        <skos:scopeNote xml:lang="ru">Это главный термин для класса.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh">此词条为该分类第一条。</skos:scopeNote>
        <skos:scopeNote xml:lang="kk">Бұл сыныптың негізгі термині.</skos:scopeNote>
        <skos:scopeNote xml:lang="ky">Бул класс үчүн эң негизги термин.</skos:scopeNote>
        <skos:scopeNote xml:lang="tg">Ин истилоҳи асосӣ барои ин синф аст.</skos:scopeNote>
        <skos:scopeNote xml:lang="tk">Bu synp üçin iň ýokary termin.</skos:scopeNote>
        <skos:scopeNote xml:lang="uz">Bu sinfning asosiy atamasi.</skos:scopeNote>
