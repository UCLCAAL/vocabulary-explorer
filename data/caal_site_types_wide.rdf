    <skos:notation>MT-1-0004</skos:notation>
    <skos:prefLabel xml:lang="en">Battlefield</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Поле битвы</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">战场</skos:prefLabel>
    <skos:prefLabel xml:lang="kk">Шайқас алаңы</skos:prefLabel>
    <skos:prefLabel xml:lang="ky">Согуш талаасы</skos:prefLabel>
    <skos:prefLabel xml:lang="tg">Майдони ҷанг</skos:prefLabel>
    <skos:prefLabel xml:lang="tk">Söweş meýdany</skos:prefLabel>
    <skos:prefLabel xml:lang="uz">Jang maydoni</skos:prefLabel>
    <skos:scopeNote xml:lang="en">An area of ground on which a battle or skirmish was fought.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Область земли, на которой велась битва или  стычка.</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">发生过武力冲突、战斗的一片区域。</skos:scopeNote>
    <skos:scopeNote xml:lang="kk">Соғыс немесе қақтығыс болған орын.</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Согуш же атышуу болгон жер аянты.</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Минтақаи замине, ки дар он ҷанг ё задухӯрд сурат гирифтааст.</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Söweş ýa-da çaknyşyk bolan ýeriň bölegi.</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">Jang yoki toʻqnashuv boʻlgan yer maydoni.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
  </skos:Concept>
