  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-1-0003">
    <skos:inScheme>
      <skos:ConceptScheme rdf:about="https://vocab.uclcaal.org/scheme/site-types">
        <skos:prefLabel xml:lang="en">Site types</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Типы объектов</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Нысан түрлері</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Ýadygärlikleriň görnüşleri</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Monument, site and landscape types for CAAL</skos:scopeNote>
        <skos:scopeNote xml:lang="ru">Типы памятников, участков и ландшафтов для CAAL</skos:scopeNote>
        <skos:scopeNote xml:lang="zh">CAAL古迹、遗址及景观类型</skos:scopeNote>
        <skos:scopeNote xml:lang="kk">CAAL үшін ескерткіштер, учаскелер және ландшафт түрлері</skos:scopeNote>
        <skos:scopeNote xml:lang="ky">CAAL үчүн эстелик, жер жана пейзаж түрлөрү</skos:scopeNote>
        <skos:scopeNote xml:lang="tg">Намудҳои ёдгориҳо, минтақаҳо ва манзараҳо барои CAAL</skos:scopeNote>
        <skos:scopeNote xml:lang="tk">CAAL üçin ýadygärlikleriň, uçastoklaryň we landşaftlaryň görnüşleri</skos:scopeNote>
        <skos:scopeNote xml:lang="uz">CAAL uchun yodgorlik, hudud va landshaft turlari</skos:scopeNote>
        <skos:hasTopConcept rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0001"/>
