  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0013">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
    <skos:notation>MT-2-0013</skos:notation>
    <skos:prefLabel xml:lang="en">Cairn</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Каирн</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">堆石</skos:prefLabel>
    <skos:prefLabel xml:lang="kk">қорған үйіндісі/тас үйіндісі</skos:prefLabel>
    <skos:prefLabel xml:lang="ky">Каирн</skos:prefLabel>
    <skos:prefLabel xml:lang="tg">Каирн</skos:prefLabel>
    <skos:prefLabel xml:lang="tk">Kairn</skos:prefLabel>
    <skos:prefLabel xml:lang="uz">tosh uyumi (memorial)</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A monument featuring a bank or mound constructed primarily of stone.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Памятник который содержит вал или насыпь, построенный в основном из камня.</skos:scopeNote>
    <skos:scopeNote xml:lang="zh">以石块为主成堆的遗迹</skos:scopeNote>
    <skos:scopeNote xml:lang="kk">Негізі тастан салынған қорған немесе үйіндіден тұратын ескерткіш.</skos:scopeNote>
    <skos:scopeNote xml:lang="ky">Эстелик негизинен таштан курулган бирок топурак менен комулгон.</skos:scopeNote>
    <skos:scopeNote xml:lang="tg">Ёдгорие, ки дорои девор ё теппае мебошад, ки асосан аз санг сохта шудааст.</skos:scopeNote>
    <skos:scopeNote xml:lang="tk">Esasan daşdan gurlan depe ýa-da mazar görnüşindäki ýadygärlik.</skos:scopeNote>
    <skos:scopeNote xml:lang="uz">Asosan toshdan qurilgan qirg‘oq yoki tepalikni o‘z ichiga olgan yodgorlik</skos:scopeNote>
    <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0017"/>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0068">
