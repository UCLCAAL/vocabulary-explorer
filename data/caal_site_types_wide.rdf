        <skos:hasTopConcept rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0017"/>
        <skos:hasTopConcept rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0018"/>
        <skos:hasTopConcept rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0019"/>
        <skos:hasTopConcept rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0020"/>
        <skos:hasTopConcept rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0021"/>
        <skos:hasTopConcept rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0022"/>
        <skos:hasTopConcept rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0023"/>
      </skos:ConceptScheme>
    </skos:inScheme>
    <skos:notation>MT-1-0003</skos:notation>
    <skos:prefLabel xml:lang="en">Archaeological feature</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Археологическая черта</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">考古特征</skos:prefLabel>
    <skos:prefLabel xml:lang="kk">Археологиялық шекара</skos:prefLabel>
    <skos:prefLabel xml:lang="ky">Археологиялык өзгөчөлүк</skos:prefLabel>
    <skos:prefLabel xml:lang="tg">Соҳаи бостоншиносӣ</skos:prefLabel>
    <skos:prefLabel xml:lang="tk">Arheologiki aýratynlyk</skos:prefLabel>
    <skos:prefLabel xml:lang="uz">Arxeologik xususiyat</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
    <skos:narrower>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0009">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
        <skos:notation>MT-2-0009</skos:notation>
        <skos:prefLabel xml:lang="en">Building</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Постройка</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">建筑</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Құрылыс</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Куруу</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Бино</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Bina</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">Qurilish</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A structure with a roof to provide shelter from the weather for occupants or contents. Use specific type where known.</skos:scopeNote>
        <skos:scopeNote xml:lang="kk">Адамдар мен ішіндегі мүлікті ауа райынан қорғауға арналған шатырлы құрылым. Белгілі болған жағдайда нақты түрін қолданыңыз</skos:scopeNote>
        <skos:scopeNote xml:lang="ky">Чатыры бар имарат, ал жерде жашоочулар же ичиндегилер үчүн аба ырайынан коргоочу жай болуп саналат.</skos:scopeNote>
        <skos:scopeNote xml:lang="tg">Сохтор бо сақф барои паноҳгоҳ аз обу ҳаво барои сокинон.</skos:scopeNote>
        <skos:scopeNote xml:lang="tk">Ýaşaýjylar ýa-da içindäki zatlar üçin howadan goramak  üçin üçekli gurluş. Belli bolsa belli bir görnüşi ulanyň.</skos:scopeNote>
        <skos:scopeNote xml:lang="uz">Yo‘lovchilar uchun ob-havodan boshpana berish uchun tomga ega bo‘lgan inshoot. Ma‘lum bo‘lgan joyda maxsus turdan foydalaning.</skos:scopeNote>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0003"/>
      </skos:Concept>
    </skos:narrower>
    <skos:narrower>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0012">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
        <skos:notation>MT-2-0012</skos:notation>
        <skos:prefLabel xml:lang="en">Buried soil</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Захороненная почва</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">埋藏土</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Жерленген топырақ</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Көмүлгөн топурак</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Хоки мадфун</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Gömülen toprak</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">Ko‘milgan tuproq (?)</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A soil profile buried beneath later deposits. A relict land surface.</skos:scopeNote>
        <skos:scopeNote xml:lang="ru">Горизонт почвы, похороненный под более поздними отложениями. Реликтовая поверхность земли (палеопочва).</skos:scopeNote>
        <skos:scopeNote xml:lang="kk">Алдыңғы шөгінділердің астыңғы қабаттарында қалған топырақ горизонты. Жердің реликті беті (палеотопырақ).</skos:scopeNote>
        <skos:scopeNote xml:lang="ky">Кийинки чөкмөлөрдүн астына көмүлгөн топурак горизонту. Жердин реликт бети (палео жер).</skos:scopeNote>
        <skos:scopeNote xml:lang="tg">Уфуқи хок дар зери таҳшинҳои навтарин гӯр шудааст. Сатҳи реликти замин (палеохокҳо).</skos:scopeNote>
        <skos:scopeNote xml:lang="tk">Soňraky çökündileriň aşagynda gömülen toprak tertibi. Relikt toprak ýüzi (paleo toprak).</skos:scopeNote>
        <skos:scopeNote xml:lang="uz">Keyinchalik cho‘kindilar ostida ko‘milgan tuproq gorizonti. Yerning relikt yuzasi (qadimgi tuproq).</skos:scopeNote>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0003"/>
      </skos:Concept>
    </skos:narrower>
    <skos:narrower>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0041">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
        <skos:notation>MT-2-0041</skos:notation>
        <skos:prefLabel xml:lang="en">Flat site</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Плоский объект</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">平地</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Жалпақ нысан</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Жалпак объект</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Объекти ҳамвор</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Tekiz obýekt</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">Tekis joy</skos:prefLabel>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0003"/>
      </skos:Concept>
    </skos:narrower>
    <skos:narrower>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0055">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
        <skos:notation>MT-2-0055</skos:notation>
        <skos:prefLabel xml:lang="en">Hearth</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Очаг</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">灶台</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Ошақ</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Очок</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Оташдон</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Ojak</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">O‘choq</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A place on which a fire is made.</skos:scopeNote>
        <skos:scopeNote xml:lang="ru">Место, на/в котором разводится огонь.</skos:scopeNote>
        <skos:scopeNote xml:lang="kk">От жағу орын.</skos:scopeNote>
        <skos:scopeNote xml:lang="ky">Өрт куйгузучуу жай</skos:scopeNote>
        <skos:scopeNote xml:lang="tg">Ҷойе, ки дар он оташ меафкананд.</skos:scopeNote>
        <skos:scopeNote xml:lang="tk">Ot ýakylýan ýer.</skos:scopeNote>
        <skos:scopeNote xml:lang="uz">Olov yoqiladigan joy.</skos:scopeNote>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0003"/>
      </skos:Concept>
    </skos:narrower>
    <skos:narrower>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0071">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
        <skos:notation>MT-2-0071</skos:notation>
        <skos:prefLabel xml:lang="en">Low mound</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Низкий бугор</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">低丘/土墩</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Аласа төмпешік</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Төмөн дөн</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Теппаи паст</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Pes depe</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">Kichik tepa</skos:prefLabel>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0003"/>
      </skos:Concept>
    </skos:narrower>
    <skos:narrower>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0087">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
        <skos:notation>MT-2-0087</skos:notation>
        <skos:prefLabel xml:lang="en">Oven</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Печь</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">炉/灶/烘箱</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Пеш</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Меш</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Танӯр</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Peç</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">Pech / O‘choq</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A brick, earth, stone or iron receptacle for baking bread or other food in.</skos:scopeNote>
        <skos:scopeNote xml:lang="ru">Кирпичная, земляная, каменная или железная ниша, предназначенная для выпечки хлеба или другой еды внутри нее.</skos:scopeNote>
        <skos:scopeNote xml:lang="kk">Нан жабуға немесе басқа да тағамдарды пісіруге арналған кірпіштен, балшықтан, тастан немесе темірден жасалған ыдыс</skos:scopeNote>
        <skos:scopeNote xml:lang="ky">Нан же башка тамак бышырууга арналган кирпич, топурак, таш же темирден жасалган атайын жай.</skos:scopeNote>
        <skos:scopeNote xml:lang="tg">Хишт, хок, санг ё оҳан зарфе барои пухтани нон ё хӯроки дигар дар.</skos:scopeNote>
        <skos:scopeNote xml:lang="tk">Çörek ýa-da beýleki iýmit bişirmek üçin kerpiç, toprak, daş ýa-da demir gap.</skos:scopeNote>
        <skos:scopeNote xml:lang="uz">Non yoki boshqa ovqatlarni pishirish uchun g‘isht, tuproq, tosh yoki temirdan yasalgan idish.</skos:scopeNote>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0003"/>
      </skos:Concept>
    </skos:narrower>
    <skos:narrower>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0092">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
        <skos:notation>MT-2-0092</skos:notation>
        <skos:prefLabel xml:lang="en">Pit</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Яма</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">灰坑</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Шұңқыр</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Чуңкур</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Чоҳ</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Çukur</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">O‘ra</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A hollow or indentation in a surface.</skos:scopeNote>
        <skos:scopeNote xml:lang="ru">Полость или углубление на поверхности.</skos:scopeNote>
        <skos:scopeNote xml:lang="kk">Бетіндегі қуыс немесе шұңқыр.</skos:scopeNote>
        <skos:scopeNote xml:lang="ky">Жер бетиндеги тереңдик же көңдөй</skos:scopeNote>
        <skos:scopeNote xml:lang="tg">Холигӣ ё чуқурӣ аз рӯи сатҳ.</skos:scopeNote>
        <skos:scopeNote xml:lang="tk">Ýeriň ýüzündäki boşluk ýada çukurlyk.</skos:scopeNote>
        <skos:scopeNote xml:lang="uz">Sirtdagi bo‘shliq yoki chuqurlik.</skos:scopeNote>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0003"/>
      </skos:Concept>
    </skos:narrower>
    <skos:narrower>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0112">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
        <skos:notation>MT-2-0112</skos:notation>
        <skos:prefLabel xml:lang="en">Stray find</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Случайная находка</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">零散发现</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Кездейсоқ табылған зат</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Кокустан табуу</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Бозёфти тасодуфӣ</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Tötän tapylan tapyndy</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">Tasodifiy topilma</skos:prefLabel>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0003"/>
      </skos:Concept>
    </skos:narrower>
    <skos:narrower>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0115">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
        <skos:notation>MT-2-0115</skos:notation>
        <skos:prefLabel xml:lang="en">Surface scatter</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Сборы с поверхности или подъемный материал</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">表层散布</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Беткі қабаттан жиналған материал</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Жер үстүндөгү жыйымдар же көтөрүүчү материал</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Маводи аз рӯу замин ёфташуда</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Ýer üstündendäki materiallar</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">Yuzadan chiqqan topilma</skos:prefLabel>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0003"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/MT-3-0026"/>
        <skos:narrower rdf:resource="https://vocab.uclcaal.org/concept/MT-3-0036"/>
      </skos:Concept>
    </skos:narrower>
    <skos:narrower>
      <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-2-0124">
        <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
        <skos:notation>MT-2-0124</skos:notation>
        <skos:prefLabel xml:lang="en">Wall</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Стена</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">墙/城墙</skos:prefLabel>
        <skos:prefLabel xml:lang="kk">Қабырға</skos:prefLabel>
        <skos:prefLabel xml:lang="ky">Дубал</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Девор</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Diwar</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">Devor</skos:prefLabel>
        <skos:broader rdf:resource="https://vocab.uclcaal.org/concept/MT-1-0003"/>
      </skos:Concept>
    </skos:narrower>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/MT-1-0020">
    <skos:inScheme rdf:resource="https://vocab.uclcaal.org/scheme/site-types"/>
    <skos:notation>MT-1-0020</skos:notation>
    <skos:prefLabel xml:lang="en">Site</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Объект</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">遗址</skos:prefLabel>
    <skos:prefLabel xml:lang="kk">Нысан</skos:prefLabel>
    <skos:prefLabel xml:lang="ky">Объект</skos:prefLabel>
    <skos:prefLabel xml:lang="tg">Ёдгорӣ</skos:prefLabel>
    <skos:prefLabel xml:lang="tk">Ýadygärlik ýer/obýekt</skos:prefLabel>
    <skos:prefLabel xml:lang="uz">Yodgorlik / obyekt</skos:prefLabel>
