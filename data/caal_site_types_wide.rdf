        <skos:prefLabel xml:lang="ky">Соода / соода</skos:prefLabel>
        <skos:prefLabel xml:lang="tg">Савдо / тиҷорат</skos:prefLabel>
        <skos:prefLabel xml:lang="tk">Söwda/täjirçilik</skos:prefLabel>
        <skos:prefLabel xml:lang="uz">Savdo / tijorat</skos:prefLabel>
