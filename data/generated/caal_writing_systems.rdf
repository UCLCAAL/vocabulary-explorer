    <skos:notation>4</skos:notation>
    <skos:topConceptOf rdf:resource="https://vocab.uclcaal.org/scheme/writing-systems"/>
    <caal:canonicalValue>Not Applicable</caal:canonicalValue>
    <skos:prefLabel xml:lang="en">Not Applicable</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Не применимо</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">都不适用</skos:prefLabel>
