        <skos:hasTopConcept rdf:resource="https://vocab.uclcaal.org/concept/writing-systems/6"/>
      </skos:ConceptScheme>
    </skos:inScheme>
    <skos:notation>6</skos:notation>
    <skos:topConceptOf rdf:resource="https://vocab.uclcaal.org/scheme/writing-systems"/>
    <caal:canonicalValue>Vertical writing</caal:canonicalValue>
    <skos:prefLabel xml:lang="en">Vertical writing</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Вертикальное письмо</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">纵书</skos:prefLabel>
    <caal:sortOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</caal:sortOrder>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/writing-systems/4">
