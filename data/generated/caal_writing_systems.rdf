    <skos:notation>3</skos:notation>
    <skos:topConceptOf rdf:resource="https://vocab.uclcaal.org/scheme/writing-systems"/>
    <caal:canonicalValue>Left-to-Right</caal:canonicalValue>
    <skos:prefLabel xml:lang="en">Left-to-Right</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Слева направо</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">自左至右</skos:prefLabel>
    <caal:sortOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</caal:sortOrder>
  </skos:Concept>
  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/writing-systems/5">
