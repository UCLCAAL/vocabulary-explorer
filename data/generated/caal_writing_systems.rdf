  <skos:Concept rdf:about="https://vocab.uclcaal.org/concept/writing-systems/6">
    <skos:inScheme>
      <skos:ConceptScheme rdf:about="https://vocab.uclcaal.org/scheme/writing-systems">
        <skos:prefLabel xml:lang="en">Writing Systems</skos:prefLabel>
