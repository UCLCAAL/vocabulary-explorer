PORT=3100
CAAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Publishing defaults already match the local vocabulary stack.
# Override only when necessary.
#
# VOCAB_REPO_ROOT=C:\CAAL\caal-vocabulary\UCLCAAL\vocabulary-explorer
# PYTHON_BIN=python
# FUSEKI_DATA_URL=http://localhost:9030/skosmos/data
# SITE_TYPES_GRAPH_URI=https://vocab.uclcaal.org/graph/monument-types
# PUBLISH_RESTART_SERVICES=true
# DOCKER_BIN=docker

# Getty searches use the approved droplet IPv4 address.
# A shared PostgreSQL gate spaces all outgoing AAT requests across processes.
# Values below 250 ms are clamped to 250 ms; increasing this slows requests.
# GETTY_MIN_INTERVAL_MS=250
# AAT_REFERENCE_GRAPH_URI=https://vocab.uclcaal.org/graph/aat-reference
